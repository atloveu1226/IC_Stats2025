#| echo: false
mc_ci <- function(chain){
n <- length(chain)/10
est <- rep(0, n)
se <- rep(0, n)
chain_vector <- as.vector(chain)
for(i in 1:n){
if (i >= 100){
mcse_result <- mcse(x = chain_vector[1:10*i], method = "bm")
I_hat <- mcse_result$est
MCSE_est <- mcse_result$se
est[i] <- I_hat
se[i] <- MCSE_est
}
else{
I_hat <- mean(chain_vector[1:10*i])
MCSE_est <- sd(chain_vector[1:10*i])
est[i] <- I_hat
se[i] <- MCSE_est
}
}
cat(length(est), length(se), "\n")
cat("The estimator by this chain is:", I_hat, "and ci is:", "[", I_hat-1.96*MCSE_est,",",    I_hat+1.96*MCSE_est,"]", "\n")
para <- data.frame(I = est, se = se)
return(para)
}
