ci_plot <- function(chain, title){
par <- mc_ci(chain)
N <- length(chain)/10
est <- par$I
sd  <- par$se
#Plot the running mean and confidence interval
plot(seq(1, N/10), est, type='l', ylim = c(2, 30), main = title)
lines(seq(1, N/10), est + 1.96 * sd , col='blue')
lines(seq(1, N/10), est - 1.96 * sd, col='green')
abline(h = true$value, col = 'red')
}
