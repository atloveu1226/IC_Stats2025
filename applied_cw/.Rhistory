param_covar <- cov(posterior_samples)
# Print out the parameter estimates and the covariance matrix.
cat("Posterior mean:\n")
param_est
cat("\n")
cat("Posterior covariance matrix:\n")
param_covar
f <- function(theta, L_data, L_star=3.44){
Delta <- theta[1]
sigma <- theta[2]
beta <- theta[3]
residuals <- L_data - (L_star + Delta)
result <- (1 + residuals^2 / sigma^2)**(-beta)
}
par <- c(0, 0.3,3)
smk$fl <- f(par, smk$capacity)
